{% extends 'base.html.twig' %}

{% block title %}Calendrier{% endblock %}

{% block body %}
    <style>
        * { box-sizing: border-box; }
        body { background: #f2f4f7; color: #1b1f24; font-family: system-ui, sans-serif; margin: 0; }
        .wrap { max-width: 900px; margin: 0 auto; padding: 16px 12px 64px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
        header h1 { font-size: 1.3rem; margin: 0; }
        header nav a { color: #6b7280; text-decoration: none; font-size: 0.85rem; }
        .flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem; }
        .flash.success { background: #dcfce7; color: #166534; }
        .flash.error { background: #fee2e2; color: #991b1b; }
        .month-nav { display: flex; align-items: center; justify-content: space-between; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; }
        .month-nav a { text-decoration: none; color: #4da3ff; font-weight: 700; font-size: 1.1rem; padding: 4px 10px; }
        .month-nav .label { font-weight: 700; text-transform: capitalize; }
        .weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px; }
        .weekdays div { text-align: center; font-size: 0.75rem; color: #6b7280; font-weight: 600; }
        .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
        .day-cell {
            display: block;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            text-decoration: none;
            color: #1b1f24;
            min-height: 64px;
            padding: 6px;
            position: relative;
        }
        .day-cell.out { opacity: 0.35; }
        .day-cell.today { border-color: #4da3ff; border-width: 2px; }
        .day-num { font-size: 0.8rem; font-weight: 600; }
        .day-preset {
            margin-top: 4px;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 2px 5px;
            border-radius: 5px;
            background: #dbeafe;
            color: #1e40af;
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .actions-row { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
        .btn-small { padding: 8px 14px; font-size: 0.85rem; border-radius: 6px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; text-decoration: none; color: #1b1f24; display: inline-block; }
        .btn-small.primary { background: #4da3ff; color: #fff; border-color: #4da3ff; }

        .paint-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 14px;
            position: sticky;
            top: 8px;
            z-index: 5;
        }
        .paint-bar .hint { font-size: 0.78rem; color: #6b7280; width: 100%; order: 99; }
        .chip {
            padding: 7px 14px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            background: #fff;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            color: #1b1f24;
        }
        .chip.active { background: #4da3ff; border-color: #4da3ff; color: #fff; }
        .chip.erase { color: #b91c1c; }
        .chip.erase.active { background: #fee2e2; border-color: #fecaca; color: #991b1b; }

        .day-cell { cursor: pointer; transition: transform 0.1s ease; }
        .day-cell.saving { opacity: 0.5; }
        .day-cell:active { transform: scale(0.95); }

        @media (max-width: 480px) {
            .day-cell { min-height: 52px; padding: 4px; }
            .day-preset { font-size: 0.6rem; }
        }
    </style>

    <div class="wrap">
        <header>
            <h1>🗓️ Calendrier</h1>
            <nav>
                <a href="{{ path('admin_preset_index') }}">Destinations</a> ·
                <a href="{{ path('admin_dashboard') }}">Admin</a> ·
                <a href="{{ path('home') }}">Tableau</a>
            </nav>
        </header>

        {% for message in app.flashes('success') %}
            <div class="flash success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash error">{{ message }}</div>
        {% endfor %}

        <div class="month-nav">
            <a href="{{ path('admin_calendar', {year: prevYear, month: prevMonth}) }}">‹</a>
            <span class="label">{{ monthLabel }}</span>
            <a href="{{ path('admin_calendar', {year: nextYear, month: nextMonth}) }}">›</a>
        </div>

        {% if presets is empty %}
            <p class="empty">Aucune destination créée. <a href="{{ path('admin_preset_new') }}">Crée-en une d'abord</a>.</p>
        {% else %}
            <div class="paint-bar" id="paint-bar">
                {% for preset in presets %}
                    <button type="button" class="chip" data-preset-id="{{ preset.id }}" data-preset-name="{{ preset.name }}">{{ preset.name }}</button>
                {% endfor %}
                <button type="button" class="chip erase" data-preset-id="">Effacer</button>
                <div class="hint" id="paint-hint">Choisis une destination, puis tape sur les jours à lui assigner — tape plusieurs jours à la suite pour aller vite.</div>
            </div>
        {% endif %}

        <div class="weekdays">
            <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
        </div>

        <div class="grid" id="calendar-grid">
            {% for day in days %}
                <div class="day-cell{{ day.inMonth ? '' : ' out' }}{{ day.isToday ? ' today' : '' }}"
                     data-date="{{ day.date|date('Y-m-d') }}"
                     data-preset-id="{{ day.calendarDay ? day.calendarDay.preset.id : '' }}">
                    <div class="day-num">{{ day.date|date('j') }}</div>
                    <span class="day-preset"{{ day.calendarDay ? '' : ' hidden' }}>{{ day.calendarDay ? day.calendarDay.preset.name : '' }}</span>
                </div>
            {% endfor %}
        </div>

        <div class="actions-row">
            <a href="{{ path('admin_preset_new') }}" class="btn-small primary">+ Nouvelle destination</a>
            <a href="{{ path('admin_calendar_import') }}" class="btn-small">Importer un CSV</a>
        </div>
    </div>

    <script>
        (function () {
            const bar = document.getElementById('paint-bar');
            if (!bar) return;

            const assignUrl = '{{ path('admin_calendar_assign') }}';
            let selected = null; // { id: string, name: string } | null

            bar.addEventListener('click', (e) => {
                const chip = e.target.closest('.chip');
                if (!chip) return;

                if (selected && selected.id === chip.dataset.presetId) {
                    selected = null;
                } else {
                    selected = { id: chip.dataset.presetId, name: chip.dataset.presetName || '' };
                }

                bar.querySelectorAll('.chip').forEach((c) => c.classList.toggle('active', selected && c.dataset.presetId === selected.id));
            });

            document.getElementById('calendar-grid').addEventListener('click', async (e) => {
                if (!selected) return;
                const cell = e.target.closest('.day-cell');
                if (!cell || cell.classList.contains('saving')) return;

                const date = cell.dataset.date;
                const presetId = selected.id === '' ? null : selected.id;

                cell.classList.add('saving');
                try {
                    const response = await fetch(assignUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ date, presetId }),
                    });
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    const data = await response.json();

                    const label = cell.querySelector('.day-preset');
                    if (data.preset) {
                        label.textContent = data.preset.name;
                        label.hidden = false;
                        cell.dataset.presetId = data.preset.id;
                    } else {
                        label.textContent = '';
                        label.hidden = true;
                        cell.dataset.presetId = '';
                    }
                } catch (err) {
                    console.error(err);
                } finally {
                    cell.classList.remove('saving');
                }
            });
        })();
    </script>
{% endblock %}
