{% extends 'admin/_layout.html.twig' %}

{% block title %}Calendrier{% endblock %}
{% block admin_title %}🗓️ Calendrier{% endblock %}

{% block admin_body %}
    <div class="month-nav">
        <a href="{{ path('admin_calendar', {year: prevYear, month: prevMonth}) }}">‹</a>
        <span class="label">{{ monthLabel }}</span>
        <a href="{{ path('admin_calendar', {year: nextYear, month: nextMonth}) }}">›</a>
    </div>

    {% if presets is empty %}
        <p class="empty">Aucune destination créée. <a href="{{ path('admin_preset_new') }}">Crée-en une d'abord</a>.</p>
    {% else %}
        <div data-controller="calendar-paint" data-calendar-paint-url-value="{{ path('admin_calendar_assign') }}">
            <div class="paint-bar">
                {% for preset in presets %}
                    <button type="button" class="chip" data-calendar-paint-target="chip" data-action="calendar-paint#pick" data-preset-id="{{ preset.id }}" data-preset-name="{{ preset.name }}">{{ preset.name }}</button>
                {% endfor %}
                <button type="button" class="chip erase" data-calendar-paint-target="chip" data-action="calendar-paint#pick" data-preset-id="">Effacer</button>
                <div class="hint">Choisis une destination, puis tape sur les jours à lui assigner — tape plusieurs jours à la suite pour aller vite.</div>
            </div>

            <div class="weekdays">
                <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
            </div>
            <div class="grid">
                {% for day in days %}
                    <div class="day-cell{{ day.inMonth ? '' : ' out' }}{{ day.isToday ? ' today' : '' }}"
                         data-calendar-paint-target="cell"
                         data-action="click->calendar-paint#paint"
                         data-date="{{ day.date|date('Y-m-d') }}"
                         data-preset-id="{{ day.calendarDay ? day.calendarDay.preset.id : '' }}">
                        <div class="day-num">{{ day.date|date('j') }}</div>
                        <span class="day-preset"{{ day.calendarDay ? '' : ' hidden' }}>{{ day.calendarDay ? day.calendarDay.preset.name : '' }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="actions-row" style="display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap;">
        <a href="{{ path('admin_preset_new') }}" class="btn-small primary">+ Nouvelle destination</a>
        <a href="{{ path('admin_calendar_import') }}" class="btn-small">Importer un CSV</a>
    </div>
{% endblock %}
