{% extends 'base.html.twig' %}

{% block title %}Importer un calendrier{% endblock %}

{% block body %}
    <style>
        body { background: #f2f4f7; color: #1b1f24; font-family: system-ui, sans-serif; margin: 0; }
        .wrap { max-width: 560px; margin: 0 auto; padding: 16px 12px 64px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        header h1 { font-size: 1.2rem; margin: 0; }
        header a { color: #6b7280; text-decoration: none; font-size: 0.85rem; }
        .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin-bottom: 16px; }
        code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-size: 0.85rem; }
        pre { background: #111827; color: #d1fae5; padding: 12px; border-radius: 8px; font-size: 0.8rem; overflow-x: auto; }
        input[type="file"] { width: 100%; margin: 12px 0; }
        button.primary { padding: 10px 18px; border-radius: 6px; border: none; background: #4da3ff; color: #fff; font-weight: 600; cursor: pointer; }
        .report { margin-top: 16px; }
        .report .ok { color: #166534; font-weight: 700; }
        .report ul { color: #991b1b; font-size: 0.85rem; padding-left: 18px; }
        .preset-list { font-size: 0.85rem; color: #4b5563; }
    </style>

    <div class="wrap">
        <header>
            <h1>📥 Importer un calendrier</h1>
            <a href="{{ path('admin_calendar') }}">Retour</a>
        </header>

        <div class="card">
            <p>Format CSV attendu, une ligne par jour :</p>
            <pre>2026-10-06,École
2026-10-07,École
2026-10-08,Travail</pre>
            <p>Le nom (2e colonne) doit correspondre <strong>exactement</strong> au nom d'une destination déjà créée :</p>
            <p class="preset-list">
                {% if presets is empty %}
                    <em>Aucune destination créée pour l'instant — <a href="{{ path('admin_preset_new') }}">crées-en une d'abord</a>.</em>
                {% else %}
                    {{ presets|map(p => p.name)|join(', ') }}
                {% endif %}
            </p>

            <form method="post" enctype="multipart/form-data">
                <input type="file" name="csv_file" accept=".csv,text/csv" required>
                <button type="submit" class="primary">Importer</button>
            </form>
        </div>

        {% if report %}
            <div class="card report">
                <p class="ok">{{ report.imported }} jour(s) importé(s).</p>
                {% if report.errors is not empty %}
                    <p>{{ report.errors|length }} ligne(s) ignorée(s) :</p>
                    <ul>
                        {% for error in report.errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
