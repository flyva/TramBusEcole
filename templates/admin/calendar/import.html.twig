{% extends 'admin/_layout.html.twig' %}

{% block title %}Importer un calendrier{% endblock %}
{% block admin_title %}📥 Importer un calendrier{% endblock %}

{% block admin_body %}
    <div class="card">
        <p>Format CSV attendu, une ligne par jour :</p>
        <pre style="background: var(--surface-2); color: var(--text); padding: 12px; border-radius: 8px; font-size: 0.8rem; overflow-x: auto; border: 1px solid var(--border);">2026-10-06,École
2026-10-07,École
2026-10-08,Travail</pre>
        <p>Le nom (2e colonne) doit correspondre <strong>exactement</strong> au nom d'une destination déjà créée :</p>
        <p class="empty">
            {% if presets is empty %}
                Aucune destination créée pour l'instant — <a href="{{ path('admin_preset_new') }}">crées-en une d'abord</a>.
            {% else %}
                {{ presets|map(p => p.name)|join(', ') }}
            {% endif %}
        </p>

        <form method="post" enctype="multipart/form-data">
            <input type="file" name="csv_file" accept=".csv,text/csv" required style="margin: 12px 0;">
            <button type="submit" class="primary">Importer</button>
        </form>
    </div>

    {% if report %}
        <div class="card">
            <p style="color: var(--success-text); font-weight: 700;">{{ report.imported }} jour(s) importé(s).</p>
            {% if report.errors is not empty %}
                <p>{{ report.errors|length }} ligne(s) ignorée(s) :</p>
                <ul style="color: var(--error-text); font-size: 0.85rem; padding-left: 18px;">
                    {% for error in report.errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
