{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ date|date('d/m/Y') }}{% endblock %}
{% block admin_title %}{{ dateLabel }}{% endblock %}

{% block admin_body %}
    <div class="card">
        {% if presets is empty %}
            <p class="empty">Aucune destination créée. <a href="{{ path('admin_preset_new') }}">Crée-en une d'abord</a>.</p>
        {% else %}
            <form method="post">
                <label>Destinations pour ce jour (une ou plusieurs)</label>

                {% for preset in presets %}
                    <label class="preset-row" style="cursor: pointer; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; margin-top: 6px;{{ preset.id in selectedPresetIds ? ' border-color: var(--primary);' : '' }}">
                        <input type="checkbox" name="preset_ids[]" value="{{ preset.id }}" {{ preset.id in selectedPresetIds ? 'checked' : '' }}>
                        <span>{{ preset.name }} {% if preset.startTime %}<small>({{ preset.startTime }}–{{ preset.endTime }})</small>{% endif %}</span>
                    </label>
                {% endfor %}

                <p class="empty" style="margin-top: 10px;">Ne coche rien pour revenir au tableau normal ce jour-là.</p>

                <button type="submit" class="primary">Enregistrer</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
