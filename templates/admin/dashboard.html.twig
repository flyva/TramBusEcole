{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <style>
        body { background: #f2f4f7; color: #1b1f24; font-family: system-ui, sans-serif; margin: 0; }
        .wrap { max-width: 720px; margin: 0 auto; padding: 24px 16px 64px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        header h1 { font-size: 1.4rem; margin: 0; }
        header a { color: #6b7280; text-decoration: none; font-size: 0.9rem; }
        .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
        .card h2 { margin: 0 0 16px; font-size: 1.1rem; }
        .flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem; }
        .flash.success { background: #dcfce7; color: #166534; }
        .flash.error { background: #fee2e2; color: #991b1b; }
        label { display: block; font-size: 0.85rem; color: #4b5563; margin: 12px 0 4px; }
        input[type="time"], input[type="text"], input[type="file"] { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #d1d5db; box-sizing: border-box; }
        .checkbox-row { display: flex; align-items: center; gap: 8px; margin: 12px 0; }
        .checkbox-row input { width: auto; }
        .times { display: flex; gap: 16px; }
        .times > div { flex: 1; }
        button.primary { margin-top: 16px; padding: 10px 18px; border-radius: 6px; border: none; background: #4da3ff; color: #fff; font-weight: 600; cursor: pointer; }
        .slide-list { display: grid; gap: 12px; }
        .slide-row { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; }
        .slide-row img { width: 70px; height: 44px; object-fit: cover; border-radius: 4px; background: #eee; }
        .slide-row .caption { flex: 1; font-size: 0.9rem; }
        .slide-row .caption small { display: block; color: #9ca3af; }
        .slide-row form { display: inline; }
        .btn-small { padding: 4px 10px; font-size: 0.8rem; border-radius: 5px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; }
        .btn-small.danger { color: #b91c1c; border-color: #fecaca; }
        .slide-row.inactive { opacity: 0.5; }
        .empty { color: #9ca3af; font-style: italic; font-size: 0.9rem; }
    </style>

    <div class="wrap">
        <header>
            <h1>🚏 Administration</h1>
            <div>
                <a href="{{ path('home') }}">Voir le tableau</a> ·
                <a href="{{ path('admin_logout') }}">Déconnexion</a>
            </div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="flash success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash error">{{ message }}</div>
        {% endfor %}

        <div class="card">
            <h2>Extinction automatique de l'écran</h2>
            {{ form_start(scheduleForm, {action: path('admin_schedule')}) }}
                <div class="checkbox-row">
                    {{ form_widget(scheduleForm.scheduleEnabled) }}
                    {{ form_label(scheduleForm.scheduleEnabled) }}
                </div>
                <div class="times">
                    <div>
                        {{ form_label(scheduleForm.screenOnTime) }}
                        {{ form_widget(scheduleForm.screenOnTime) }}
                    </div>
                    <div>
                        {{ form_label(scheduleForm.screenOffTime) }}
                        {{ form_widget(scheduleForm.screenOffTime) }}
                    </div>
                </div>
                <button type="submit" class="primary">Enregistrer</button>
            {{ form_end(scheduleForm) }}
        </div>

        <div class="card">
            <h2>Ajouter une image au diaporama</h2>
            {{ form_start(slideForm, {action: path('admin_slide_upload'), attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_label(slideForm.imageFile) }}
                {{ form_widget(slideForm.imageFile) }}
                {{ form_errors(slideForm.imageFile) }}
                {{ form_label(slideForm.caption) }}
                {{ form_widget(slideForm.caption) }}
                <button type="submit" class="primary">Ajouter</button>
            {{ form_end(slideForm) }}
        </div>

        <div class="card">
            <h2>Images du diaporama ({{ slides|length }})</h2>
            {% if slides is empty %}
                <p class="empty">Aucune image ajoutée pour l'instant.</p>
            {% else %}
                <div class="slide-list">
                    {% for slide in slides %}
                        <div class="slide-row{{ slide.active ? '' : ' inactive' }}">
                            <img src="{{ asset('uploads/slides/' ~ slide.filename) }}" alt="">
                            <div class="caption">
                                {{ slide.caption ?: 'Sans légende' }}
                                <small>{{ slide.active ? 'Active' : 'Désactivée' }}</small>
                            </div>
                            <form method="post" action="{{ path('admin_slide_toggle', {id: slide.id}) }}">
                                <button type="submit" class="btn-small">{{ slide.active ? 'Désactiver' : 'Activer' }}</button>
                            </form>
                            <form method="post" action="{{ path('admin_slide_delete', {id: slide.id}) }}" onsubmit="return confirm('Supprimer cette image ?');">
                                <button type="submit" class="btn-small danger">Supprimer</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
