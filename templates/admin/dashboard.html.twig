{% extends 'admin/_layout.html.twig' %}

{% block title %}Administration{% endblock %}

{% block admin_body %}
    <div class="card">
        <h2>📍 Adresse du tableau</h2>
        <div data-controller="address-autocomplete">
            {{ form_start(originForm, {action: path('admin_origin')}) }}
                {{ form_label(originForm.originAddress) }}
                <div class="address-wrap" style="position: relative;">
                    {{ form_widget(originForm.originAddress, {attr: {'data-address-autocomplete-target': 'input', 'data-action': 'input->address-autocomplete#onInput'}}) }}
                    <ul class="suggestions" hidden data-address-autocomplete-target="suggestions"></ul>
                </div>
                {{ form_errors(originForm.originAddress) }}
                {{ form_widget(originForm.originLat, {attr: {'data-address-autocomplete-target': 'lat'}}) }}
                {{ form_widget(originForm.originLng, {attr: {'data-address-autocomplete-target': 'lng'}}) }}
                <button type="submit" class="primary">Enregistrer</button>
            {{ form_end(originForm) }}
        </div>
    </div>

    <div class="card">
        <h2>🌙 Extinction automatique de l'écran</h2>

        <div class="slide-list" id="period-list" data-controller="admin-ajax" style="margin-bottom: 16px;">
            {% if periods is empty %}
                <p class="empty" id="period-empty">Aucune plage d'extinction. L'écran reste toujours allumé.</p>
            {% endif %}
            {% for period in periods %}
                <div class="slide-row{{ period.enabled ? '' : ' inactive' }}" data-period-row="{{ period.id }}">
                    <div class="caption">
                        Éteint de <strong>{{ period.startTime }}</strong> à <strong>{{ period.endTime }}</strong>
                        <small>{{ period.enabled ? 'Active' : 'Désactivée' }}</small>
                    </div>
                    <button type="button" class="btn-small" data-action="admin-ajax#toggle"
                            data-url="{{ path('admin_screen_off_toggle', {id: period.id}) }}">
                        {{ period.enabled ? 'Désactiver' : 'Activer' }}
                    </button>
                    <button type="button" class="btn-small danger" data-action="admin-ajax#delete"
                            data-url="{{ path('admin_screen_off_delete', {id: period.id}) }}"
                            data-confirm="Supprimer cette plage ?">
                        Supprimer
                    </button>
                </div>
            {% endfor %}
        </div>

        {{ form_start(periodForm, {action: path('admin_screen_off_new')}) }}
            <div class="times">
                <div>
                    {{ form_label(periodForm.startTime) }}
                    {{ form_widget(periodForm.startTime) }}
                </div>
                <div>
                    {{ form_label(periodForm.endTime) }}
                    {{ form_widget(periodForm.endTime) }}
                </div>
            </div>
            <button type="submit" class="primary">+ Ajouter une plage</button>
        {{ form_end(periodForm) }}
    </div>

    <div class="card">
        <h2>🖼️ Ajouter une image au diaporama</h2>
        {{ form_start(slideForm, {action: path('admin_slide_upload'), attr: {enctype: 'multipart/form-data'}}) }}
            {{ form_label(slideForm.imageFile) }}
            {{ form_widget(slideForm.imageFile) }}
            {{ form_errors(slideForm.imageFile) }}
            {{ form_label(slideForm.caption) }}
            {{ form_widget(slideForm.caption) }}
            <button type="submit" class="primary">Ajouter</button>
        {{ form_end(slideForm) }}
    </div>

    <div class="card">
        <h2>📝 Ajouter un rappel (texte)</h2>
        {{ form_start(slideTextForm, {action: path('admin_slide_text_new')}) }}
            {{ form_label(slideTextForm.caption) }}
            {{ form_widget(slideTextForm.caption) }}
            {{ form_label(slideTextForm.text) }}
            {{ form_widget(slideTextForm.text) }}
            {{ form_errors(slideTextForm.text) }}
            <button type="submit" class="primary">Ajouter</button>
        {{ form_end(slideTextForm) }}
    </div>

    <div class="card">
        <h2>Diaporama (<span id="slide-count">{{ slides|length }}</span>)</h2>
        <div class="slide-list" id="slide-list" data-controller="admin-ajax">
            {% if slides is empty %}
                <p class="empty" id="slide-empty">Rien ajouté pour l'instant.</p>
            {% endif %}
            {% for slide in slides %}
                <div class="slide-row{{ slide.active ? '' : ' inactive' }}" data-slide-row="{{ slide.id }}">
                    {% if slide.type == 'text' %}
                        <div class="caption">
                            <strong>{{ slide.caption ?: 'Rappel' }}</strong> — {{ slide.text|length > 60 ? slide.text|slice(0, 60) ~ '…' : slide.text }}
                            <small>{{ slide.active ? 'Active' : 'Désactivée' }}</small>
                        </div>
                    {% else %}
                        <img src="{{ asset('uploads/slides/' ~ slide.filename) }}" alt="">
                        <div class="caption">
                            {{ slide.caption ?: 'Sans légende' }}
                            <small>{{ slide.active ? 'Active' : 'Désactivée' }}</small>
                        </div>
                    {% endif %}
                    <button type="button" class="btn-small" data-action="admin-ajax#toggle"
                            data-url="{{ path('admin_slide_toggle', {id: slide.id}) }}">
                        {{ slide.active ? 'Désactiver' : 'Activer' }}
                    </button>
                    <button type="button" class="btn-small danger" data-action="admin-ajax#delete"
                            data-url="{{ path('admin_slide_delete', {id: slide.id}) }}"
                            data-confirm="Supprimer ce slide ?" data-remove-target="slide">
                        Supprimer
                    </button>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
