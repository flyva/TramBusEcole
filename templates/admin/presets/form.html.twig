{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ preset.id ? 'Modifier' : 'Nouvelle' }} destination{% endblock %}
{% block admin_title %}📍 {{ preset.id ? 'Modifier' : 'Nouvelle' }} destination{% endblock %}

{% block admin_body %}
    <div class="card">
        {{ form_start(form) }}
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}

            <div data-controller="address-autocomplete">
                {{ form_label(form.address) }}
                <div class="address-wrap">
                    {{ form_widget(form.address, {attr: {'data-address-autocomplete-target': 'input', 'data-action': 'input->address-autocomplete#onInput'}}) }}
                    <ul class="suggestions" hidden data-address-autocomplete-target="suggestions"></ul>
                </div>
                {{ form_errors(form.address) }}
                {{ form_widget(form.lat, {attr: {'data-address-autocomplete-target': 'lat'}}) }}
                {{ form_widget(form.lng, {attr: {'data-address-autocomplete-target': 'lng'}}) }}
            </div>

            <div class="times">
                <div>
                    {{ form_label(form.startTime) }}
                    {{ form_widget(form.startTime) }}
                </div>
                <div>
                    {{ form_label(form.endTime) }}
                    {{ form_widget(form.endTime) }}
                </div>
            </div>

            <div class="checkbox-row">
                {{ form_widget(form.enabled) }}
                {{ form_label(form.enabled) }}
            </div>

            <button type="submit" class="primary">Enregistrer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
