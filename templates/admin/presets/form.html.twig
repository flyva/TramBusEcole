{% extends 'base.html.twig' %}

{% block title %}{{ preset.id ? 'Modifier' : 'Nouvelle' }} destination{% endblock %}

{% block body %}
    <style>
        body { background: #f2f4f7; color: #1b1f24; font-family: system-ui, sans-serif; margin: 0; }
        .wrap { max-width: 560px; margin: 0 auto; padding: 24px 16px 64px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        header h1 { font-size: 1.4rem; margin: 0; }
        header a { color: #6b7280; text-decoration: none; font-size: 0.9rem; }
        .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
        label { display: block; font-size: 0.85rem; color: #4b5563; margin: 14px 0 4px; }
        input[type="text"], input[type="time"] { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #d1d5db; box-sizing: border-box; }
        .address-wrap { position: relative; }
        .suggestions { position: absolute; z-index: 10; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid #d1d5db; border-top: none; border-radius: 0 0 6px 6px; list-style: none; margin: 0; padding: 0; max-height: 220px; overflow-y: auto; }
        .suggestions li { padding: 8px 10px; cursor: pointer; font-size: 0.9rem; border-bottom: 1px solid #f3f4f6; }
        .suggestions li:hover { background: #f3f4f6; }
        .days { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
        .days label { display: flex; align-items: center; gap: 4px; margin: 0; font-size: 0.85rem; }
        .days input { width: auto; }
        .times { display: flex; gap: 16px; }
        .times > div { flex: 1; }
        .checkbox-row { display: flex; align-items: center; gap: 8px; margin: 14px 0; }
        .checkbox-row input { width: auto; }
        button.primary { margin-top: 20px; padding: 10px 18px; border-radius: 6px; border: none; background: #4da3ff; color: #fff; font-weight: 600; cursor: pointer; }
        .errors { color: #b91c1c; font-size: 0.8rem; margin-top: 4px; }
    </style>

    <div class="wrap">
        <header>
            <h1>📍 {{ preset.id ? 'Modifier' : 'Nouvelle' }} destination</h1>
            <a href="{{ path('admin_preset_index') }}">Retour</a>
        </header>

        <div class="card">
            {{ form_start(form) }}
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}

                <div data-controller="address-autocomplete">
                    {{ form_label(form.address) }}
                    <div class="address-wrap">
                        {{ form_widget(form.address, {attr: {'data-address-autocomplete-target': 'input', 'data-action': 'input->address-autocomplete#onInput'}}) }}
                        <ul class="suggestions" hidden data-address-autocomplete-target="suggestions"></ul>
                    </div>
                    {{ form_errors(form.address) }}
                    {{ form_widget(form.lat, {attr: {'data-address-autocomplete-target': 'lat'}}) }}
                    {{ form_widget(form.lng, {attr: {'data-address-autocomplete-target': 'lng'}}) }}
                </div>

                {{ form_label(form.daysOfWeek) }}
                <div class="days">
                    {% for child in form.daysOfWeek %}
                        <label>{{ form_widget(child) }} {{ child.vars.label }}</label>
                    {% endfor %}
                </div>

                <div class="times">
                    <div>
                        {{ form_label(form.startTime) }}
                        {{ form_widget(form.startTime) }}
                    </div>
                    <div>
                        {{ form_label(form.endTime) }}
                        {{ form_widget(form.endTime) }}
                    </div>
                </div>

                <div class="checkbox-row">
                    {{ form_widget(form.enabled) }}
                    {{ form_label(form.enabled) }}
                </div>

                <button type="submit" class="primary">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
